# Optional: improves matching and cover letters.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set to false after an initial interactive login if a source needs it.
HEADLESS=false
# A site-specific CSS selector for vacancy cards, only if generic discovery fails.
SOURCE_HIREHI_CARD= a.job-card[data-id]
SOURCE_ROCKETHUNT_CARD=
SOURCE_DREAMJOB_CARD=
SOURCE_HIRIFY_CARD=
SOURCE_TAYLOR_CARD=
SOURCE_JOBROCKET_CARD=
SOURCE_RVC_CARD=

# HH.ru API
# Register an application at https://dev.hh.ru/admin and use client_credentials.
# You can provide HH_ACCESS_TOKEN directly instead of client id/secret.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_USER_AGENT=QA_Job_AI/0.1 (contact: your-email@example.com)
HH_HOST=hh.ru
HH_LOCALE=RU
HH_PERIOD_DAYS=5
HH_MAX_PAGES=1
HH_PER_PAGE=50
HH_WORK_FORMAT=REMOTE
HH_SEARCH_QUERIES=QA,QA Engineer,Manual QA,QA Tester,Тестировщик,Инженер по тестированию,Функциональный тестировщик
HH_API_TIMEOUT_SECONDS=30
HH_API_RETRIES=3

