# Optional: improves matching and cover letters.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set to false after an initial interactive login if a source needs it.
HEADLESS=false
# A site-specific CSS selector for vacancy cards, only if generic discovery fails.
SOURCE_HIREHI_CARD= a.job-card[data-id]
SOURCE_ROCKETHUNT_CARD=
SOURCE_DREAMJOB_CARD=
SOURCE_HIRIFY_CARD=
SOURCE_TAYLOR_CARD=
SOURCE_JOBROCKET_CARD=
SOURCE_RVC_CARD=

# HH.ru official API / OAuth2
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/oauth/callback
HH_AUTH_MODE=user
HH_TOKEN_FILE=.hh_tokens.json
HH_USER_AGENT=QA_Job_AI/0.2 (contact: your-email@example.com)
HH_HOST=hh.ru
HH_LOCALE=RU
HH_SEARCH_TEXTS=QA Engineer,Manual QA,QA,Тестировщик
HH_PERIOD_DAYS=5
HH_PER_PAGE=100
HH_MAX_VACANCIES=1000
HH_DETAIL_CONCURRENCY=10
HH_API_TIMEOUT_SECONDS=30
HH_API_RETRIES=3
HH_FORCE_LOGIN=false
# Interactive HH CAPTCHA handling when the API returns captcha_url.
HH_CAPTCHA_INTERACTIVE=true
HH_CAPTCHA_BACKURL=https://hh.ru/

# Vacancy API authorization: user | application | auto | anonymous
HH_VACANCY_AUTH_MODE=application
HH_APPLICATION_TOKEN=
HH_APPLICATION_TOKEN_FILE=.hh_app_token.json
