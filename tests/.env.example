# Optional: improves matching and cover letters.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Scan mode is headless by default.
HEADLESS=true

# Performance tuning.
SOURCE_CONCURRENCY=6
DETAIL_CONCURRENCY=12
MAX_VACANCIES=25
PAGE_TIMEOUT_MS=20000
SELECTOR_TIMEOUT_MS=7000

# Site-specific CSS selector overrides.
SOURCE_HIREHI_CARD=a.job-card[data-id]
SOURCE_ROCKETHUNT_CARD=
SOURCE_DREAMJOB_CARD=
SOURCE_HIRIFY_CARD=
SOURCE_TAYLOR_CARD=
SOURCE_JOBROCKET_CARD=
SOURCE_RVC_CARD=
